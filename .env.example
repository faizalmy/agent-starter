# ============================================
# AI Agent Workflow Starter - Environment Variables
# ============================================

# --------------------------------------------
# REQUIRED - OpenAI API
# --------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...


# --------------------------------------------
# OPTIONAL - Additional AI Providers
# --------------------------------------------
# Groq API (for DeepSeek R1 distilled model)
# Get your API key from: https://console.groq.com
# GROQ_API_KEY=gsk-...

# Google Generative AI (for Gemini models)
# Get your API key from: https://aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=...

# Vercel AI Gateway (for gateway/* models)
# Get your API key from: https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY=vck-...


# --------------------------------------------
# OPTIONAL - Model Configuration
# --------------------------------------------
# Default model to use (if not specified in UI)
# Options: openai/gpt-5, openai/gpt-4o, openai/gpt-4o-mini, openai/o4-mini, google/gemini-2.5-pro, google/gemini-1.5-pro, google/gemini-1.5-flash
# AI_MODEL=openai/gpt-5


# --------------------------------------------
# OPTIONAL - Reasoning Features
# --------------------------------------------
# Enable reasoning summaries for models with reasoning
# ENABLE_REASONING=false

# Level of reasoning detail to include
# Options: auto | detailed
# OPENAI_REASONING_SUMMARY=auto

# How much reasoning effort to use
# Options: minimal | low | medium | high
# OPENAI_REASONING_EFFORT=high


# --------------------------------------------
# NOTES
# --------------------------------------------
# 1. Copy this file to .env.local and fill in your actual values
# 2. .env.local is gitignored and never committed to source control
# 3. For production deployment, set these variables in your hosting provider
# 4. Only OPENAI_API_KEY is required to get started


# --------------------------------------------
# OPTIONAL - Web Crawling (Teracrawl)
# --------------------------------------------
# Teracrawl API endpoint for web crawling tool
# Default: http://localhost:8085
# Set this if Teracrawl is running on a different host/port
# TERACRAWL_API_URL=http://localhost:8085
#
# Note: Teracrawl service must be running separately
# The Teracrawl service requires BROWSER_API_KEY (configured in Teracrawl)
# See: https://github.com/BrowserCash/teracrawl

# --------------------------------------------
# REQUIRED - Clerk Authentication
# --------------------------------------------
# Get your keys from: https://dashboard.clerk.com
# Create a new application and copy the keys from the API Keys section
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY


# --------------------------------------------
# REQUIRED - Supabase Database & Storage
# --------------------------------------------
# Prisma database connection string (for chat persistence)
# Get from Supabase: Settings → Database → Connection String (Transaction mode)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project URL (for Storage)
# Get from Supabase: Settings → API → Project URL
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase service role key (for Storage - server-side only)
# Get from Supabase: Settings → API → service_role key (secret)
# WARNING: Never expose this key to the client - it has admin access
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage bucket name for attachments
# Default: attachments (create this bucket in Supabase Storage)
SUPABASE_STORAGE_BUCKET=attachments
# Direct connection URL for Prisma migrations (required for Supabase)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres